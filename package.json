{
  "name": "blueworx-forge",
  "private": true,
  "version": "2.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint . && npm run check:decisions",
    "check:decisions": "node bin/check-decisions.mjs",
    "test": "playwright test",
    "test:unit": "node --test \"tests/unit/**/*.test.mjs\"",
    "build:zip": "vite build && bash bin/build-zip.sh",
    "zip": "npm run build:zip",
    "wp:up": "node ../bluegroup_core_foundation/scripts/wp-test-env.mjs up --plugin . --slug blueworx-forge --dir .wp-test --port 8892",
    "wp:down": "node ../bluegroup_core_foundation/scripts/wp-test-env.mjs down --dir .wp-test"
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/vite": "4.1.12",
    "@types/react": "18.3.1",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "jiti": "^2.7.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "4.1.12",
    "typescript": "5.8.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^6.4.3"
  }
}
