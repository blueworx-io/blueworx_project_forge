        "selector": "JSXOpeningElement[name.name='BulkActions'] > JSXAttribute > JSXIdentifier[name!=/^(?:count|actions|value|onChange|onApply|className|key|ref|className|style|children)$/]",
        "message": "<BulkActions> doesn't accept that prop. Declared props: count, actions, value, onChange, onApply, className."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|variant|size|icon|iconRight|block|disabled|href|type|onClick|className|key|ref|className|style|children)$/]",
