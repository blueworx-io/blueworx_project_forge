<?xml version="1.0"?>
<ruleset name="ForgeProjectManagement">
	<description>
		WordPress Coding Standards for Forge Project Management.

		The whole standard is on, including every security, escaping, i18n and
		database sniff — those found four unescaped outputs and a missing
		translators comment, all fixed rather than silenced. Three groups are
		excluded below, each for a stated reason. Nothing security-related is
		among them, and the individual suppressions in includes/ are annotated
		one by one where they sit.
	</description>

	<!-- Only lint php files, show sniff codes (s) and progress (p). -->
	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg value="sp"/>
	<arg name="parallel" value="8"/>

	<!-- The plugin's own runtime PHP. -->
	<file>forge-project-management.php</file>
	<file>uninstall.php</file>
	<file>includes</file>
	<file>templates</file>

	<exclude-pattern>*/vendor/*</exclude-pattern>
	<exclude-pattern>*/node_modules/*</exclude-pattern>
	<exclude-pattern>*/plugin-update-checker/*</exclude-pattern>
	<exclude-pattern>*/.wp-test/*</exclude-pattern>

	<rule ref="WordPress">
		<!--
			Documentation sniffs. This codebase comments what is not obvious and
			leaves the rest to read itself; the sniffs would demand a docblock on
			all 74 methods and a full stop on 53 inline comments, adding prose
			without adding information. A method whose behaviour needs explaining
			still gets a docblock — several already have one.
		-->
		<exclude name="Squiz.Commenting.FunctionComment"/>
		<exclude name="Squiz.Commenting.FileComment"/>
		<exclude name="Squiz.Commenting.ClassComment"/>
		<exclude name="Squiz.Commenting.InlineComment.InvalidEndChar"/>

		<!--
			Style preferences the plugin applies consistently: `?:` where a value
			has a fallback, and conditions written subject-first. Both read better
			than the alternative and neither has ever caused a bug here.
		-->
		<exclude name="Universal.Operators.DisallowShortTernary"/>
		<exclude name="WordPress.PHP.YodaConditions"/>

		<!--
			Would rename all nine files in includes/ to match their class names
			(class-forge-pm-enqueue.php and so on). Nothing loads them by
			convention — the main plugin file requires each by name — so the rename
			buys nothing at runtime and rewrites the history of every file.
		-->
		<exclude name="WordPress.Files.FileName.InvalidClassFileName"/>
	</rule>

	<!-- Every global symbol carries the plugin's own prefix. A plugin shares one
	     PHP process with every other plugin on the site. -->
	<rule ref="WordPress.NamingConventions.PrefixAllGlobals">
		<properties>
			<property name="prefixes" type="array">
				<element value="forge_pm"/>
				<element value="FORGE_PM"/>
				<element value="Forge_PM"/>
			</property>
		</properties>
	</rule>

	<rule ref="WordPress.WP.I18n">
		<properties>
			<property name="text_domain" type="array">
				<element value="forge-pm"/>
			</property>
		</properties>
	</rule>

	<config name="minimum_wp_version" value="6.5"/>
</ruleset>
